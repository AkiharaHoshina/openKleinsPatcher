# ★★★ `patches/lua/` 里是**编译后的 LuaJIT 字节码**，不是文本！
#   必须显式标 binary —— 否则哪天 git 把它当文本做行尾转换（LF↔CRLF），
#   打进客户端的 wrapper 就废了，而且是**静默**废掉（字节数变一点，谁也看不出来）。
patches/lua/**  binary

# 文本：统一 LF，省得跨平台 diff 噪音
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.spec  text eol=lf
*.txt   text eol=lf

# ★ .bat 必须 CRLF，否则 cmd 会把行切碎（实测过）。
#   而且它们是 GBK 编码，git 不要动字节。
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制：禁止行尾转换 / 文本 diff
*.exe   binary
*.zip   binary
*.png   binary
*.jpg   binary
